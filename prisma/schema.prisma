generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Company {
  id          String @id @default(cuid())
  name        String
  nameKey     String @unique
  website     String @default("")
  domain      String? @unique
  contact     String @default("")
  role        String @default("")
  connection  String @default("")
  permission  Boolean @default(false)
  owner       String
  latestRunId String?
  resultsRunId String?
  firstTeam   String?
  createdAt   DateTime @default(now())
  runs        ResearchRun[]
  opportunities Opportunity[]
}

model ResearchRun {
  id        String @id
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  source    String
  status    String
  remoteId  String? @unique
  error     String?
  input     Json
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, createdAt])
}

model Opportunity {
  id        String @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  teamKey   String
  details   Json
  source    String
  originalSubject String
  originalBody String
  subject   String
  body      String
  owner     String
  contact   String
  role      String
  status    String @default("Draft")
  reviewer  String?
  approvedAt DateTime?
  lastContact DateTime?
  revision  Int @default(0)
  @@unique([companyId, teamKey])
}
